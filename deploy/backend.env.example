# Copy this file to /www/waterplant.whyfjz.com/backend.env on the server.
# Do not commit the real backend.env.

# LLM
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

# Runtime data source
# mock: use built-in mock data
# external: use EXTERNAL_DATA_BASE_URL
DATA_SOURCE=mock
EXTERNAL_DATA_BASE_URL=
EXTERNAL_DATA_TIMEOUT_MS=5000

# Cockpit direct API
COCKPIT_DIRECT_API_BASE_URL=http://example.com/vpad
COCKPIT_DIRECT_API_PATH_PREFIX=/a
COCKPIT_DIRECT_USERNAME=system
COCKPIT_DIRECT_PASSWORD=change-me
COCKPIT_DIRECT_TIMEOUT_MS=10000
COCKPIT_DIRECT_SESSION_TTL_SECONDS=1500

# Cockpit cache and build behavior
COCKPIT_BUILD_WAIT_TIMEOUT_SECONDS=20
COCKPIT_LEADERSHIP_CACHE_TTL_SECONDS=300
COCKPIT_COST_OVERVIEW_CACHE_TTL_SECONDS=600
COCKPIT_UNIT_ANALYSIS_CACHE_TTL_SECONDS=300
COCKPIT_LEADERSHIP_START_DATE=2025-12-06

# Reserved for future page-tool mode
COCKPIT_PAGE_TOOL_ROOT=

# rag
RAG_ENABLED=True
RAG_RETRIEVAL_MODE=hybrid
RAG_WIKIDB_ROOT=/app/wikidb

# RAG embedding
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BASE_URL=https://your-compatible-endpoint/compatible-mode/v1
RAG_EMBEDDING_API_KEY=your-embedding-api-key
RAG_EMBEDDING_REQUEST_DIMENSION=true

# RAG vector store
QDRANT_URL=http://qdrant:6333
RAG_QDRANT_COLLECTION=water_plant_rag_chunks
RAG_VECTOR_DIMENSION=1024
RAG_QDRANT_DISTANCE=Cosine

# RAG keyword store
ELASTICSEARCH_URL=http://elasticsearch:9200
RAG_ELASTICSEARCH_INDEX=water_plant_rag_chunks

# RAG SQL state store
# Keep this password aligned with POSTGRES_PASSWORD in the compose environment.
RAG_DATABASE_URL=postgresql://water_plant:change-me@postgres:5432/water_plant
RAG_STATE_SQLITE_PATH=

# RAG hybrid defaults
RAG_RRF_K=60
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=1.0
RAG_HYBRID_CANDIDATE_K=80
RAG_FUSION_KEEP=50
RAG_FINAL_TOP_K=10
RAG_DOC_CHUNK_LIMIT=3

# RAG ACL baseline
RAG_DEFAULT_VISIBILITY=public
RAG_DEFAULT_TENANT=
RAG_DEFAULT_ROLES=

# RAG retrieval observability
RAG_RETRIEVAL_LOG_PATH=/app/data/rag_logs/retrieval.jsonl
RAG_RETRIEVAL_LOG_INCLUDE_QUERY=true
RAG_RETRIEVAL_RAISE_ERRORS=false

# Optional reranker. Disabled until a compatible endpoint is provided.
RAG_RERANK_ENABLED=false
RAG_RERANK_ENDPOINT=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TOP_N=10
RAG_RERANK_TIMEOUT_SECONDS=20
