# Copy service-specific examples when needed.
# Frontend example: frontend/.env.example

# Local Docker Compose variables.
QDRANT_IMAGE=qdrant/qdrant:v1.12.4
QDRANT_STORAGE_PATH=E:/path/to/docker-data/water_plant/qdrant/storage
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.4
ELASTICSEARCH_DATA_PATH=E:/path/to/docker-data/water_plant/elasticsearch/data
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
POSTGRES_IMAGE=postgres:18.0-bookworm
POSTGRES_DATA_PATH=E:/path/to/docker-data/water_plant/postgres/data
POSTGRES_DB=water_plant
POSTGRES_USER=water_plant
POSTGRES_PASSWORD=change-me
