LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

DATA_SOURCE=mock
EXTERNAL_DATA_BASE_URL=
EXTERNAL_DATA_TIMEOUT_MS=5000

RAG_ENABLED=false
RAG_RETRIEVAL_MODE=hybrid
RAG_WIKIDB_ROOT=
RAG_LEGACY_WIKI_KEYWORD=false
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BASE_URL=https://your-compatible-endpoint/compatible-mode/v1
RAG_EMBEDDING_API_KEY=your-embedding-api-key-here
RAG_EMBEDDING_REQUEST_DIMENSION=true

QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_COLLECTION=water_plant_rag_chunks
RAG_VECTOR_DIMENSION=1024
RAG_QDRANT_DISTANCE=Cosine

ELASTICSEARCH_URL=http://127.0.0.1:9200
RAG_ELASTICSEARCH_INDEX=water_plant_rag_chunks

# Local scripts use host-mapped PostgreSQL by default. Docker Compose overrides this to postgres:5432.
RAG_DATABASE_URL=postgresql://water_plant:change-me@127.0.0.1:5432/water_plant
RAG_STATE_SQLITE_PATH=

# RAG hybrid defaults
RAG_RRF_K=60
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=1.0
RAG_HYBRID_CANDIDATE_K=80
RAG_FUSION_KEEP=50
RAG_FINAL_TOP_K=10
RAG_DOC_CHUNK_LIMIT=3

# RAG ACL baseline. Public knowledge is visible to all; private/internal knowledge needs tenant or role filters.
RAG_DEFAULT_VISIBILITY=public
RAG_DEFAULT_TENANT=
RAG_DEFAULT_ROLES=

# RAG retrieval observability
RAG_RETRIEVAL_LOG_PATH=
RAG_RETRIEVAL_LOG_INCLUDE_QUERY=true
RAG_RETRIEVAL_RAISE_ERRORS=false

# Optional reranker. Disabled until a compatible endpoint is provided.
RAG_RERANK_ENABLED=false
RAG_RERANK_ENDPOINT=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TOP_N=10
RAG_RERANK_TIMEOUT_SECONDS=20
